<resources>
    <string name="app_name">AA Next</string>
    <string name="description">Tweaks for Android Auto</string>
    <string-array name="scope">
        <item>com.google.android.projection.gearhead</item>
        <item>android</item>
    </string-array>

    <string name="not_active">AA Next isn’t reaching Android Auto yet: it isn’t turned on in the Xposed manager, or Android Auto still needs a restart. Tap here to set it up.</string>

    <string name="welcome_title">Welcome to AA Next</string>
    <string name="welcome_text">Tweaks for Android Auto. It works from inside Android Auto as an Xposed module, so check these first.</string>
    <string name="welcome_checks">Setup</string>
    <string name="welcome_continue">Continue</string>
    <string name="check_root">Root access</string>
    <string name="check_root_summary">To restart Android Auto, show the car screen on this phone and close apps for real. Tap to ask again</string>
    <string name="check_xposed">Enabled in %1$s</string>
    <string name="check_xposed_summary">AA Next has to be turned on in the Xposed manager’s module list. Tap for how</string>
    <string name="check_android_auto">Running in Android Auto</string>
    <string name="check_android_auto_summary">Android Auto has to be in AA Next’ scope and restarted after that. Tap to restart it and check again</string>
