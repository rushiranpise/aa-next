    <string name="framework_help_title">Enable AA Next in %1$s</string>
    <string name="framework_help_message">Open your Xposed manager — the LSPosed or Vector app, or the notification it posts. Turn on AA Next, tick Android Auto in its scope (and System Framework if Android Auto didn’t come preinstalled), then come back here.</string>

    <string name="section_status">Status</string>
    <string name="section_driving">Driving</string>
    <string name="no_lockouts">Always parked</string>
    <string name="no_lockouts_summary">The keyboard, typing and full lists stay unlocked while the car moves, for anyone using the screen</string>

    <string name="section_apps">Apps</string>
    <string name="any_app_launcher">Phone apps on the car screen</string>
    <string name="any_app_launcher_summary">A Phone Apps tab in the launcher opens any app, and the games move into Car Optimized Apps</string>
    <string name="phone_app_size">Phone app size</string>
    <string name="phone_app_size_default">Android Auto’s size</string>
    <string name="pinned_apps">Pinned apps</string>
    <string name="pinned_apps_none">Choose apps to show first in the launcher</string>
    <string name="search_apps">Search apps</string>
    <string name="search_no_apps">No apps match</string>
    <string name="start_on_launcher">Start on the app launcher</string>
    <string name="start_on_launcher_summary">Android Auto opens on its app launcher without starting a navigation app or music. Open what you want yourself</string>
    <string name="recents">Recents button</string>
    <string name="recents_summary">A button above the apps button lists the apps you opened, to switch between them or close them. Closing one of two leaves the other on its own</string>
    <string name="recents_title">Open apps</string>
    <string name="recents_close_all">Close all</string>
    <string name="recents_close">Close</string>
    <string name="recents_empty">No open apps</string>
    <string name="any_car_app">Sideloaded car apps</string>
