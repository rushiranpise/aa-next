<resources>
    <string name="app_name">AA Next</string>
    <string name="description">Tweaks for Android Auto</string>
    <string-array name="scope">
        <item>com.google.android.projection.gearhead</item>
        <item>android</item>
    </string-array>

    <string name="not_active">AA Next is not working in Android Auto yet. Turn it on in your Xposed manager, then restart Android Auto. Tap here for setup help.</string>

    <string name="welcome_title">Welcome to AA Next</string>
    <string name="welcome_text">AA Next adds features to Android Auto. It works as an Xposed module, so complete these steps first.</string>
    <string name="welcome_checks">Setup</string>
    <string name="welcome_continue">Continue</string>
    <string name="check_root">Root access</string>
    <string name="check_root_summary">Root lets AA Next restart Android Auto, show it on your phone, and close apps. Tap to request access again.</string>
    <string name="check_xposed">Enabled in %1$s</string>
    <string name="check_xposed_summary">Turn on AA Next in your Xposed manager. Tap for instructions.</string>
    <string name="check_android_auto">Running in Android Auto</string>
    <string name="check_android_auto_summary">Add Android Auto to AA Next\'s scope, then restart it. Tap to restart and check again.</string>
