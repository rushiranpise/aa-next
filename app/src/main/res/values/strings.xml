    <string name="no_forced_apps">No required Google apps</string>
    <string name="no_forced_apps_summary">Runs without Google Maps, the Google app or Speech Services</string>
    <string name="hide_news_weather">Hide News and Weather</string>
    <string name="hide_news_weather_summary">Removes the Assistant’s News and Weather tiles</string>
    <string name="default_nav">Default navigation</string>
    <string name="default_media">Default media</string>
    <string name="android_auto_choice">Android Auto’s choice</string>

    <string name="section_notifications">Notifications</string>
    <string name="mute_notifications">Mute notifications</string>
    <string name="mute_notifications_summary">Calls, media and navigation still show</string>
    <string name="notification_timeout">Notifications stay</string>
    <string name="notification_timeout_default">Android Auto\'s 8 seconds</string>
    <string name="notification_timeout_seconds">%1$d seconds</string>

    <string name="section_phone_screen">No screen in the car</string>
    <string name="phone_screen">Car screen on this phone</string>
    <string name="phone_screen_summary">Shows Android Auto on this phone itself, the way the car screen would. Starts Android Auto’s own head unit server, which needs root</string>
    <string name="headunit_unreachable">Couldn’t reach Android Auto. Allow AA Next root access in your root manager and try again</string>
    <string name="headunit_ended">Android Auto ended the phone screen</string>

    <string name="section_performance">Performance</string>
    <string name="lighter">Lighter on the phone</string>
    <string name="lighter_summary">Draws the car screen at 30 frames a second at most, 20 while nobody touches it, and slows down sooner when the phone gets hot or Battery Saver is on. Helps most on older phones</string>
    <string name="video_resolution">Car screen resolution</string>
    <string name="video_resolution_car">The car’s choice</string>

    <string name="section_privacy">Privacy</string>
    <string name="no_telemetry">Disable telemetry</string>
    <string name="no_telemetry_summary">Stops Android Auto’s telemetry and diagnostics logging</string>

    <string name="section_custom">Custom screen</string>
    <string name="custom_tile">UX Prototype app</string>
    <string name="custom_tile_summary">Android Auto’s hidden web app, opening the page below</string>
    <string name="custom_tile_url">Page it opens</string>

    <string name="section_system">System</string>
    <string name="microg">Use microG instead of Play Services</string>
    <string name="microg_summary">Android Auto gets everything it needs from Play Services from an installed microG app such as Morphe’s MicroG-RE, and never reaches Play Services itself. Works with or without Play Services on the phone</string>
    <string name="microg_missing">Not installed</string>
    <string name="microg_installed">Installed %1$s</string>
    <string name="microg_install_title">MicroG-RE isn’t installed</string>
    <string name="microg_install_message">This switch hands everything Android Auto needs from Play Services to a microG app, so it needs MicroG-RE. Download it, install it, then come back here.</string>
    <string name="microg_install_button">Download</string>
    <string name="microg_location_title">Allow location for %1$s</string>
    <string name="microg_location_message">Android Auto now gets the car’s location from %1$s. In its app info, open Permissions, then Location, and choose Allow all the time.</string>
    <string name="microg_location_button">Open app info</string>
    <string name="microg_system_title">Give Android Auto system access</string>
    <string name="microg_system_message">Android Auto didn’t come preinstalled on this phone, so it also needs the system access a preinstalled one has. In %1$s, add System Framework to AA Next’ scope, then reboot.</string>
    <string name="later">Later</string>

