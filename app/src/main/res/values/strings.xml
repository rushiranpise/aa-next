    <string name="status_restart_aa">Not yet</string>
    <string name="framework_help_title">Enable AA Next in %1$s</string>
    <string name="framework_help_message">Open your Xposed manager or tap its notification. Enable AA Next and select Android Auto in its scope. If Android Auto did not come preinstalled, also select System Framework. Then come back here.</string>

    <string name="no_lockouts">Unlock while driving</string>
    <string name="no_lockouts_summary">Keep the keyboard, typing, and full lists available while the car is moving.</string>

    <string name="any_app_launcher">Phone apps on the car screen</string>
    <string name="any_app_launcher_summary">Adds a Phone Apps tab to the launcher so you can open any phone app. Games appear under Car Optimized Apps.</string>
    <string name="phone_app_size">Phone app size</string>
    <string name="phone_app_size_default">Android Auto default</string>
    <string name="pinned_apps">Pinned apps</string>
    <string name="pinned_apps_none">Choose apps to show first in the launcher</string>
    <string name="search_apps">Search apps</string>
    <string name="search_no_apps">No matching apps</string>
    <string name="start_on_launcher">Open the app launcher first</string>
    <string name="start_on_launcher_summary">Android Auto opens the app launcher without starting navigation or music. Choose what to open.</string>
    <string name="recents">Recent apps button</string>
    <string name="recents_summary">Adds a button above the apps button to show, switch between, or close open apps.</string>
    <string name="recents_title">Open apps</string>
    <string name="recents_close_all">Close all</string>
    <string name="recents_close">Close</string>
    <string name="recents_empty">No open apps</string>
    <string name="any_car_app">Sideloaded car apps</string>
    <string name="any_car_app_summary">Show Android Auto apps that were installed outside the Play Store.</string>
    <string name="no_forced_apps">Run without Google apps</string>
    <string name="no_forced_apps_summary">Run without Google Maps, the Google app, or Speech Services.</string>
    <string name="hide_news_weather">Hide News and Weather</string>
    <string name="hide_news_weather_summary">Remove the News and Weather cards from Assistant.</string>
    <string name="default_nav">Default navigation app</string>
    <string name="default_media">Default media app</string>
    <string name="android_auto_choice">Android Auto default</string>

    <string name="mute_notifications">Mute notifications</string>
    <string name="mute_notifications_summary">Calls, media, and navigation notifications will still show.</string>
    <string name="notification_timeout">Notification duration</string>
    <string name="notification_timeout_default">Android Auto\'s default</string>
    <string name="notification_timeout_seconds">%1$d seconds</string>

    <string name="phone_screen">Show car screen on this phone</string>
    <string name="phone_screen_summary">Show Android Auto on this phone instead of a car display. This starts Android Auto\'s head unit server and needs root.</string>
    <string name="headunit_unreachable">Could not connect to Android Auto. Allow AA Next root access in your root manager, then try again.</string>
    <string name="headunit_ended">Android Auto closed the phone screen.</string>

    <string name="lighter">Reduce phone load</string>
    <string name="lighter_summary">Limits the car screen to 30 frames per second, or 20 when idle. It also reduces performance sooner when the phone gets hot or Battery Saver is on. Most useful on older phones.</string>
    <string name="video_resolution">Car screen resolution</string>
    <string name="video_resolution_car">Use the car\'s choice</string>

    <string name="no_telemetry">Disable telemetry</string>
    <string name="no_telemetry_summary">Stop Android Auto from collecting telemetry and diagnostic logs.</string>

    <string name="custom_tile">UX Prototype app</string>
    <string name="custom_tile_summary">Open Android Auto\'s hidden web app at the page below.</string>
    <string name="custom_tile_url">Page to open</string>

    <string name="microg">Use microG instead of Play Services</string>
    <string name="microg_summary">Android Auto uses an installed microG app, such as Morphe\'s MicroG-RE, instead of connecting to Google Play Services. This works whether or not Play Services is installed.</string>
    <string name="microg_missing">Not installed</string>
    <string name="microg_installed">Installed %1$s</string>
    <string name="microg_install_title">MicroG-RE is not installed</string>
    <string name="microg_install_message">Android Auto needs MicroG-RE to use this option. Download and install it, then come back here.</string>
    <string name="microg_install_button">Download</string>
    <string name="microg_location_title">Allow location for %1$s</string>
    <string name="microg_location_message">Android Auto now gets the car\'s location from %1$s. Open its app info, go to Permissions → Location, and select Allow all the time.</string>
    <string name="microg_location_button">Open app info</string>
    <string name="microg_system_title">Give Android Auto system access</string>
    <string name="microg_system_message">Android Auto was not preinstalled on this phone, so it needs extra system access. In %1$s, add System Framework to AA Next\'s scope, then restart your phone.</string>
    <string name="later">Later</string>

